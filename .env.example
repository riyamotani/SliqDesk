# Copy to .env to override defaults. Every value here is a working default for
# local development; none of them is a real secret.

# --- Database (Postgres) ---
POSTGRES_USER=sliqdesk
POSTGRES_PASSWORD=sliqdesk
POSTGRES_DB=sliqdesk
DATABASE_URL=postgresql://sliqdesk:sliqdesk@localhost:5432/sliqdesk

# --- Redis (job queue + real-time fan-out) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Signs the session token. Use a long random value in any real deployment.
JWT_SECRET=dev-only-secret-change-me-please
JWT_TTL_HOURS=168
# Set to true when served over HTTPS so the cookie is only sent over TLS.
COOKIE_SECURE=false

# --- SLA ---
# Minutes a high/urgent ticket may wait for an Admin/Agent comment before it
# is flagged overdue. Decimals allowed (0.5 = 30 seconds) for quick demos.
SLA_MINUTES=2
# How often the worker sweeps for overdue tickets as a safety net.
SLA_SWEEP_SECONDS=60

# --- API ---
PORT=4000
LOG_LEVEL=info

{
  "info": {
    "_postman_id": "7d1f6c2e-3b4a-4f5e-9a8b-1c2d3e4f5a6b",
    "name": "SliqDesk API",
    "description": "Demo flow for the SliqDesk API. Start the stack with `docker compose up --build`, then use\n**Run collection** (top to bottom). Requests depend on earlier ones (login cookie, saved ids).\n\n- `baseUrl` defaults to http://localhost:8080 (through nginx); http://localhost:4000 also works.\n- Authentication is a session cookie set by login/sign-up; Postman stores and sends it automatically.\n- Seeded logins use the password `password123`.\n- Errors always look like `{ \"error\": { \"code\", \"message\", \"details?\" } }`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "",
      "type": "string"
    },
    {
      "key": "myId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Log in as Acme Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Sets the httpOnly session cookie; Postman sends it with the following requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@acme.test\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('logged in as admin@acme.test', () => pm.expect(pm.response.json().user.email).to.eql('admin@acme.test'));",
                  "pm.collectionVariables.set('myId', pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('role is admin of Acme', () => { const u = pm.response.json().user; pm.expect(u.role).to.eql('admin'); pm.expect(u.organization.name).to.eql('Acme Support'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {

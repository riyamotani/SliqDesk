{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles the app, so resolve modules the way bundlers do.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false
  },
  "include": ["src", "vite.config.ts"]
}
